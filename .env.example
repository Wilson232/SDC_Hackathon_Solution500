# FindMyCareer configuration template
# Put real secret values in Replit Secrets (or a local .env file).
# Never commit real API keys, credentials, or a populated .env file.

PROJECT_NAME=FindMyCareer

# Database connection used by server/db.mjs and tests
DATABASE_URL=your-postgresql-connection-string

# Clerk authentication: set these if using Clerk sign-in
VITE_CLERK_PUBLISHABLE_KEY=your-clerk-publishable-key
CLERK_PUBLISHABLE_KEY=your-clerk-publishable-key
CLERK_SECRET_KEY=your-clerk-secret-key

# Optional Clerk proxy setting (only if your deployment requires it)
# VITE_CLERK_PROXY_URL=your-clerk-proxy-url

# Optional: comma-separated admin email addresses
# ADMIN_EMAILS=admin@example.com

# Optional: Replit Object Storage certificate bucket
# CERTIFICATE_BUCKET_ID=your-certificate-bucket-id

# Apify: only needed if you add code that calls the Apify API at runtime.
# The current source archive does not directly reference APIFY_API_TOKEN.
# APIFY_API_TOKEN=your-apify-api-token

# Botpress Webchat is embedded; no private Botpress API token is needed
# for a standard public webchat embed.
